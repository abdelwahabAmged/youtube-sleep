<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark sleep theme: black background, no splash, dark bars -->
    <style name="Theme.YtSleep" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0B0F</item>
        <item name="android:statusBarColor">#0B0B0F</item>
        <item name="android:navigationBarColor">#0B0B0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
